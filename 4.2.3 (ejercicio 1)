#include <iostream>
using namespace std;
int main() {
    int A, B;
    cout << "Ingrese el numero A: ";
    cin >> A;
    cout << "Ingrese el numero B: ";
    cin >> B;
    if (B != 0) {
        if (A % B == 0) {
        cout << A << " es divisible " << B << endl;
        } else {
            cout << A << " no es divisible " << B << endl;
        }
    } 
    else {
        cout << "No se puede dividir entre cero." << endl;
    }
    return 0;
}
